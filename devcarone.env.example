# Copy to devcarone.env beside the launcher and uncomment settings as needed.
# Values are literal: no quotes, shell expansion, or inline comments.
# Environment variables override this file; omitted settings use defaults.
# Keep passwords and tokens out of this file.

# MAINDIR=/srv/devcarone
# NETWORK=devnet
# DNS=192.0.2.53
# FORGEJO_URL=https://forgejo.example.com
# FORGEJO_USER=your-forgejo-user
