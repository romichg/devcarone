#!/bin/sh
# git credential helper for the Forgejo token mounted by devcarone. Git supplies
# the username from configuration. Only `get` is answered; store/erase requests
# are ignored so the token is never written anywhere else.
[ "${1:-}" = get ] || exit 0
cat > /dev/null
token_file=${FORGEJO_TOKEN_PATH:-/run/devcar/forgejo-token}
[ -r "$token_file" ] || exit 0
printf 'password=%s\n' "$(cat "$token_file")"
